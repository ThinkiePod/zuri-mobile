{
  "expo": {
    "name": "Zuri",
    "slug": "zuri-companion-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icons/ios-light.png",
    "scheme": "zuri",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    // "splash": {
    //   "image": "./assets/icons/splash-icon-dark.png",
    //   "resizeMode": "contain",
    //   "backgroundColor": "#A367BB"
    // },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.zuri.companion",
      "buildNumber": "1.0.0",
      "infoPlist": {
        "NSFaceIDUsageDescription": "Use Face ID to quickly and securely access your account.",
        "NSCameraUsageDescription": "Camera access is needed for taking profile photos.",
        "NSMicrophoneUsageDescription": "Microphone access is needed for voice interactions with Zuri.",
        "NSBluetoothPeripheralUsageDescription": "Bluetooth is required to connect with your Zuri device.",
        "ITSAppUsesNonExemptEncryption": false
      },
      "icon": {
        "dark": "./assets/icons/ios-dark.png",
        "tinted": "./assets/icons/ios-tinted.png",
        "light": "./assets/icons/ios-light.png"
      }
    },
    "android": {
      "package": "com.zuri.companion",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/icons/adaptive-icon.png",
        "monochromeImage": "./assets/icons/adaptive-icon.png",
        "backgroundColor": "#A367BB"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.BLUETOOTH",
        "android.permission.BLUETOOTH_ADMIN",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.USE_FINGERPRINT",
        "android.permission.USE_BIOMETRIC"
      ],
      "edgeToEdgeEnabled": true,
      "softwareKeyboardLayoutMode": "pan"
    },
    "web": {
      "bundler": "metro",
      "output": "server",
      "favicon": "./assets/icons/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-web-browser",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#ffffff",
          "sounds": ["./assets/sounds/notification.mp3"]
        }
      ],
      // [
      //   "expo-splash-screen",
      //   {
      //     "image": "./assets/icons/splash-icon-light.png",
      //     "imageWidth": 200,
      //     "resizeMode": "contain",
      //     "backgroundColor": "#A367BB",
      //     "dark": {
      //       "image": "./assets/icons/splash-icon-dark.png",
      //       "backgroundColor": "#A367BB"
      //     }
      //   }
      // ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow Zuri Companion to use Face ID for secure authentication."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Zuri Companion to access your camera for profile photos."
        }
      ],
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "The app accesses your photos to let you share them with your child's profile.",
          "cameraPermission": "Allow Zuri to open the camera",

          "//": "Disables the microphone permission",
          "microphonePermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "46ea668a-aeb5-45b2-b7b0-eb9101ca47a8"
      }
    },
    "owner": "waleathinkiepod"
  }
}
